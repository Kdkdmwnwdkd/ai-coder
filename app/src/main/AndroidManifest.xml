<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============= 【M3 UI 层占位 + M5 JNI 正式启用】权限 ============= -->
    <!-- Android 13+：通知栏（推理前台服务Notification + 剪贴板Toast提示） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 13+：选择照片做背景（SAF Intent不需要，占位保留） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 占位：下载模型、拉取插件更新 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- M5 新增：推理期间启动前台Service（防 Flyme 后台杀） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (API 34) 新增：前台Service类型必选。llama.cpp推理没有精确匹配的官方分类，用 specialUse + 属性说明 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- M6 ACTION 标签：震动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.XuediCoder"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.XuediCoder.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M5 新增：推理前台保活 Service。魅族 Flyme 后台策略严格，
             推理中常驻通知栏"AI编程助手推理中…"。
             foregroundServiceType=specialUse 是 Android 14 对 "LLM推理" 这一新场景的折中：
             没有官方的 remoteMessaging/health/playback 等精确匹配类型，specialUse +
             property:android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE 给出明确文字说明即可过审。 -->
        <service
            android:name=".model.InferenceForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="本地GGUF大模型推理(llama.cpp-JNI)前台保活，防止系统在长时间推理期间回收进程。" />
        </service>

        <!-- FileProvider：SAF 导入 GGUF / 背景照片后 分享文件URI 用 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    
        <!-- code78 新增：无障碍服务（系统级操控，首次手动授权一次永久生效） -->
        <service
            android:name=".action.CoderAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
    <!-- Android 11+ (API 30+)：包可见性声明
         没有 queries 声明时 getLaunchIntentForPackage()/getPackageInfo()
         对非系统 app 一律返回 null → open_app "未安装" 假阳性。 -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.smile.gifmaker" />
        <package android:name="com.android.settings" />
        <package android:name="com.android.chrome" />
        <package android:name="com.tencent.smtt.sdk" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>
