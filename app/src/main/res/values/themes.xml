<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 极简纯白主题：不引入 SplashScreen 库，避免额外依赖导致编译失败 -->
    <style name="Theme.XuediCoder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/x_very_light_gray</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/x_very_light_gray</item>
        <item name="android:navigationBarColor">@color/x_white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- 给 Manifest 启动 Activity 用的主题（和 App 主题保持一致即可） -->
    <style name="Theme.XuediCoder.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/x_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/x_white</item>
        <item name="android:navigationBarColor">@color/x_white</item>
    </style>
</resources>
